    // ===== v3.7 (١): المتابعة — الثابت ١٠ =====
    match /follows/{docId} {
      function followerOfDoc() { return docId.split('_')[0]; }
      function curatorOfDoc() { return docId.split('_')[1]; }
      // v3.17 (١١ · ق٣-١): السجل مربوط بعدّاد المتابعين في الاتجاهين، والمتابعة لمن له محتوى عام أو موثَّق فقط (من سواه لا عدّاد له يُحرَّك)
      function fProfile() { return /databases/$(database)/documents/communityProfiles/$(curatorOfDoc()); }
      function fCountable() {
        return get(fProfile()).data.get('hasAnyPublicContent', false) == true || get(fProfile()).data.get('verified', false) == true;
      }
      function followCounted() {
        return fCountable()
          && getAfter(fProfile()).data.get('followerCount', 0) == get(fProfile()).data.get('followerCount', 0) + 1;
      }
      function followReleased() { // لا عدّاد يُنقَص: الملف حُذف · العدّاد عند الصفر · لم يعد معدودًا · صاحب السجل موقوف (حق الانسحاب)
        return !exists(fProfile())
          || get(fProfile()).data.get('followerCount', 0) <= 0
          || !fCountable()
          || isSuspended()
          || (existsAfter(fProfile()) && getAfter(fProfile()).data.get('followerCount', 0) == get(fProfile()).data.get('followerCount', 0) - 1);
      }
