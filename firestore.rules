      function shownNickOk() { // v3.17 (١٤ · ق٣-٤): على القائمة العامة فقط
        return request.resource.data.get('public', false) != true || nickMine(request.resource.data.get('nickname', null));
      }
      // v3.8 (السطران ٣ و١٩): bookmarkCount وviewCount يبدآن صفرًا/غائبين (نمط ١٦)
      allow create: if isSignedIn() && !isSuspended()
        && request.resource.data.ownerId == request.auth.uid
        && docId.split('_')[0] == request.auth.uid
