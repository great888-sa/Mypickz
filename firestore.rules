    // ===== v3.3 (أ) عدّادات الكيانات — stats_curators =====
    // M4.25 (١١): مدينة × يوم — stats_cities/{cityId}__YYYY-MM-DD
    match /stats_cities/{docId} {
      function keysOk() { return request.resource.data.keys().hasOnly(['open', 'place_added', 'trip_built']) && request.resource.data.keys().size() >= 1; }
      function createOk() { return keysOk() && bumpC('open') && bumpC('place_added') && bumpC('trip_built'); }
      function updateOk() { return keysOk() && request.resource.data.diff(resource.data).affectedKeys().size() >= 1 && bumpU('open') && bumpU('place_added') && bumpU('trip_built'); }
      allow read: if isOwner();
      allow create: if isSignedIn() && docId.split('__').size() == 2 && docId.matches('[a-z0-9_-]{1,40}__[0-9]{4}-[0-9]{2}-[0-9]{2}') && dayNear(docId.split('__')[1]) && createOk();
      allow update: if isSignedIn() && docId.split('__').size() == 2 && docId.matches('[a-z0-9_-]{1,40}__[0-9]{4}-[0-9]{2}-[0-9]{2}') && dayNear(docId.split('__')[1]) && updateOk();
      allow delete: if isOwner();
    }

    match /stats_curators/{docId} {
      function keysOk() { return request.resource.data.keys().hasOnly(['page_view', 'follow', 'contact_click', 'ref_social', 'ref_card', 'export', 'save']) && request.resource.data.keys().size() >= 1; } // v3.14: + save (ب-٢)
      function createOk() { return keysOk() && bumpC('page_view') && bumpC('follow') && bumpC('contact_click') && bumpC('ref_social') && bumpC('ref_card') && bumpC('export') && bumpC('save'); }
      function updateOk() { return keysOk() && request.resource.data.diff(resource.data).affectedKeys().size() >= 1 && bumpU('page_view') && bumpU('follow') && bumpU('contact_click') && bumpU('ref_social') && bumpU('ref_card') && bumpU('export') && bumpU('save'); } // M4.25 (٩) §١٧-ج · v3.14 save
      allow read: if isOwner() || (isSignedIn() && docId.split('__')[0] == request.auth.uid);
      allow create: if docId.matches('[A-Za-z0-9]{20,40}(__[0-9]{4}-[0-9]{2}-[0-9]{2})?') && entId(docId) && exists(/databases/$(database)/documents/communityProfiles/$(docId.split('__')[0])) && createOk();
      allow update: if docId.matches('[A-Za-z0-9]{20,40}(__[0-9]{4}-[0-9]{2}-[0-9]{2})?') && entId(docId) && exists(/databases/$(database)/documents/communityProfiles/$(docId.split('__')[0])) && updateOk();
      allow delete: if isOwner();
    }
    // ===== v3.3 (أ) عدّادات الكيانات — stats_cards =====
    match /stats_cards/{docId} {
      function keysOk() { return request.resource.data.keys().hasOnly(['view_total', 'view_social']) && request.resource.data.keys().size() >= 1; }
      function createOk() { return keysOk() && bumpC('view_total') && bumpC('view_social'); }
      function updateOk() { return keysOk() && request.resource.data.diff(resource.data).affectedKeys().size() >= 1 && bumpU('view_total') && bumpU('view_social'); } // M4.25 (٩) §١٧-ج
      allow read: if isOwner() || (isSignedIn() && docId.split('__')[0] == request.auth.uid);
      allow create: if docId.matches('[A-Za-z0-9]{20,40}__[A-Za-z0-9_-]{4,40}') && createOk();
      allow update: if docId.matches('[A-Za-z0-9]{20,40}__[A-Za-z0-9_-]{4,40}') && updateOk();
      allow delete: if isOwner();
    }

  }
}
