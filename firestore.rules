        && request.resource.data.curatorUid == curatorOfDoc()
        && request.resource.data.curatorUid != request.auth.uid
        && exists(/databases/$(database)/documents/communityProfiles/$(curatorOfDoc()))
        && docId == request.auth.uid + '_' + request.resource.data.curatorUid // v3.17 (١١): لا سجل ثانٍ للزوج نفسه بمعرّف ملحَق
        && (!('at' in request.resource.data) || request.resource.data.at is timestamp || request.resource.data.at is number) // v3.17 (١٠)
        && followCounted();
      allow update: if false;
      allow delete: if isOwner() || (isSignedIn() && resource.data.followerUid == request.auth.uid && followReleased());
    }

    // M4.25 (٤): سجل النسخ بإسناد — copies/{uid}__{docKey} · ينشئه صاحبه فقط · لا تعديل ولا حذف (النسخة قد تبقى عنده) · القراءة لصاحبه والمالك
    match /copies/{docId} {
      // v3.16 (١-ب · r117-أ · المراجعة المستقلة): سجل حفظ المكان (docKey = p_<معرّف العدّاد>) مربوط بعدّاده في الاتجاهين —
      //   يُنشأ فقط مع +١ على عدّاده بالطلب نفسه (أو إنشائه بواحد) · ويُحذف فقط مع −١ بالطلب نفسه، أو حين لا عدّاد يُنقص (غائب أو عند الصفر).
      //   بربط العدّاد وحده كان يكفي طلبان: سجل يُنشأ وحده ثم يُحذف مع −١ (تصفير عدّاد الغير) · أو يُحذف وحده بعد +١ ثم يُعاد (تضخيم).
      function isSaveRec() { return docId.split('__')[1].matches('p_[a-f0-9]{16}'); }
      function saveCounter() { return /databases/$(database)/documents/placeFavoriteCounts/$(docId.split('__p_')[1]); }
      function saveCounted() {
        return existsAfter(saveCounter())
          && ((!exists(saveCounter()) && getAfter(saveCounter()).data.count == 1)
              || (exists(saveCounter()) && getAfter(saveCounter()).data.count == get(saveCounter()).data.count + 1));
      }
      function saveReleased() {
        return !exists(saveCounter())
          || get(saveCounter()).data.count <= 0
          || (existsAfter(saveCounter()) && getAfter(saveCounter()).data.count == get(saveCounter()).data.count - 1);
      }
      // v3.17 (١١): سجل نسخ القائمة والرحلة مربوط بعدّاد copyCount على مصدره في الاتجاهين (النمط نفسه) — سجل نسخ المكان المفرد (place بغير بصمة) إسناد بلا عدّاد فيبقى حرًّا
      function copyList() { return /databases/$(database)/documents/userCityLists/$(docId.split('__')[1]); }
      function copyTrip() { return /databases/$(database)/documents/trips/$(docId.split('__')[1]); }
      function cntUp(p) { return getAfter(p).data.get('copyCount', 0) == get(p).data.get('copyCount', 0) + 1; }
      function cntFree(p) { // لا عدّاد يُنقَص: المصدر حُذف · العدّاد عند الصفر · لم يعد عامًّا ولا مشارَكًا معي · صاحب السجل موقوف
        return !exists(p)
          || get(p).data.get('copyCount', 0) <= 0
          || !(get(p).data.get('public', false) == true || request.auth.uid in get(p).data.get('sharedWith', []))
          || isSuspended()
          || (existsAfter(p) && getAfter(p).data.get('copyCount', 0) == get(p).data.get('copyCount', 0) - 1);
      }
      // v3.16 (١-ج): القراءة لصاحب الحقل uid أيضًا — الاستعلام where('uid','==',uid) (حذف الحساب) يُثبت هذا الشرط؛ شرط المعرّف وحده لا يُثبته استعلام
      allow read: if isOwner() || (isSignedIn() && ((resource != null && resource.data.uid == request.auth.uid) || docId.split('__')[0] == request.auth.uid));
      allow create: if isSignedIn() && !isSuspended()
        && docId.split('__')[0] == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'kind', 'docKey', 'at'])
        && request.resource.data.keys().hasAll(['uid', 'kind', 'docKey'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.kind in ['trip', 'list', 'place']
        && request.resource.data.docKey is string && request.resource.data.docKey == docId.split('__')[1]
        && (!isSaveRec() || saveCounted())
        && (!('at' in request.resource.data) || request.resource.data.at is timestamp || request.resource.data.at is number) // v3.17 (١٠)
        && (request.resource.data.kind != 'list' || cntUp(copyList())) // v3.17 (١١)
        && (request.resource.data.kind != 'trip' || cntUp(copyTrip()));
      allow update: if false;
      allow delete: if isOwner() || (isSignedIn() && docId.split('__')[0] == request.auth.uid
        && (!isSaveRec() || saveReleased())
        && (resource == null || resource.data.get('kind', '') != 'list' || cntFree(copyList())) // v3.17 (١١) · (١٥): سجل غير موجود يُحذف بلا شرط كما كان
        && (resource == null || resource.data.get('kind', '') != 'trip' || cntFree(copyTrip()))); // M4.26 (١)(٢): لصاحبه — العدّاد اللحظي وحذف الحساب
    }

    // M4.25 (٦): رأي المنتقي بالمدينة — curatorCityNotes/{uid}__{cityId}
    match /curatorCityNotes/{docId} {
      function notesFieldsOk() {
        return request.resource.data.keys().hasOnly(['uid', 'cityId', 'text', 'bestTime', 'love', 'knownFor', 'whyPrefer', 'returns', 'updatedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.cityId == docId.split('__')[1]
          && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 300))
          && (!('bestTime' in request.resource.data) || (request.resource.data.bestTime is string && request.resource.data.bestTime.size() <= 40))
          && (!('love' in request.resource.data) || (request.resource.data.love is string && request.resource.data.love.size() <= 80))
          && (!('knownFor' in request.resource.data) || (request.resource.data.knownFor is string && request.resource.data.knownFor.size() <= 80))
          && (!('whyPrefer' in request.resource.data) || (request.resource.data.whyPrefer is string && request.resource.data.whyPrefer.size() <= 80))
          && (!('returns' in request.resource.data) || request.resource.data.returns in ['yes', 'sometimes', 'no']);
      }
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && !isSuspended()
        && docId.split('__')[0] == request.auth.uid
        && isVerifiedUser(request.auth.uid)
        && notesFieldsOk();
      allow delete: if isOwner() || (isSignedIn() && docId.split('__')[0] == request.auth.uid);
    }

    // M4.25 (٧): طلب الصيرورة — مرة لصاحبه؛ الحالة يغيّرها المالك فقط
    match /curatorRequests/{uid} {
      allow read: if isOwner() || (isSignedIn() && request.auth.uid == uid);
      allow create: if isSignedIn() && !isSuspended() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'text', 'at', 'status'])
        && request.resource.data.uid == uid
        && request.resource.data.get('status', 'pending') == 'pending'
        && (!('at' in request.resource.data) || (request.resource.data.at is number // v3.17 (١٥): وقت الطلب ضمن يوم من ساعة الخادم — وقت صفر كان يفتح إعادة الطلب فورًا
            && request.resource.data.at >= request.time.toMillis() - 86400000
            && request.resource.data.at <= request.time.toMillis() + 86400000))
        && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 300));
      // v3.17 (١٣ · ق٣-٣ — «اسبوع» ق١١-١٢-٠٥): المرفوض يعيد طلبه بعد أسبوع من تاريخ طلبه، بتعديل مستنده (الحذف يبقى لحذف الحساب)
      allow update: if (isOwner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['pending', 'accepted', 'declined'])
        || (isSignedIn() && !isSuspended() && request.auth.uid == uid
          && resource.data.status == 'declined'
          && request.resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'text', 'at'])
          && request.resource.data.at is number && request.resource.data.at >= resource.data.at + 604800000
          && request.resource.data.at <= request.time.toMillis() + 86400000
          && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 300)));
      allow delete: if isOwner() || (isSignedIn() && request.auth.uid == uid); // M4.26 (٢)
    }

    // M4.25 (٧): البلاغات — المسجَّل ينشئ؛ المالك يقرأ ويحذف
    match /reports/{docId} {
      allow read: if isOwner() || (isSignedIn() && resource.data.by == request.auth.uid); // v3.17 (١٢): صاحب البلاغ — استعلام حذف الحساب where('by','==',uid)
      allow create: if isSignedIn() && !isSuspended()
        && request.resource.data.keys().hasOnly(['by', 'kind', 'docKey', 'reason', 'at'])
        && request.resource.data.keys().hasAll(['by', 'kind'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.kind in ['place', 'list', 'trip', 'profile', 'notes', 'app'] // M4.26 (٦)
        && (!('docKey' in request.resource.data) || (request.resource.data.docKey is string && request.resource.data.docKey.size() <= 120)) // v3.17 (١٠): النوع يُفحص حيثما وُجد الحقل (كان يُفلت مع kind app)
        && (request.resource.data.kind == 'app' || 'docKey' in request.resource.data)
