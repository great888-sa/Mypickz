    // v3.11 (ز-١-ج): سجل هوية الأماكن — معلومة نملكها تتراكم مع كل تأكيد على الخريطة
    match /placeIdentity/{hash} {
      allow read: if true;
      function idFieldsOk() {
        return isSignedIn() && !isSuspended()
          && request.resource.data.keys().hasOnly(['lat', 'lng', 'source', 'openId', 'n', 'cityId', 'by', 'at'])
          && request.resource.data.keys().hasAll(['lat', 'lng', 'source', 'by', 'at'])
