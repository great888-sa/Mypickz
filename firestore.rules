    }

    // ===== v3.8 (السطر ٢): سجل مفكرة القوائم — الثابت ١٢: نية خاصة لصاحبها، العلني عدّادها المجمَّع فقط =====
    // listBookmarks/{bookmarkerUid}__{listDocId}: الفاصل مزدوج لأن معرّف القائمة يحوي شرطة مفردة (uid_cityId).
    // القراءة لصاحب السجل ومالك التطبيق فقط — صاحب القائمة لا يرى مَن (قرار المالك أ · «كم لا مَن»).
    // الإنشاء على قائمة مدينة عامة قائمة فعلًا · الحقل الوحيد at · لا تعديل أبدًا · الحذف لصاحبه (والموقوف — انسحاب) ولمالك التطبيق.
    match /listBookmarks/{docId} {
      function bmOwner() { return docId.split('__')[0]; }
      function bmTarget() { return docId.split('__')[1]; }
      // v3.17 (١١): السجل مربوط بعدّاد bookmarkCount في الاتجاهين (نمط v3.16 ١-ب)
      function bmList() { return /databases/$(database)/documents/userCityLists/$(bmTarget()); }
      function bmCounted() {
        return getAfter(bmList()).data.get('bookmarkCount', 0) == get(bmList()).data.get('bookmarkCount', 0) + 1;
      }
      function bmReleased() { // لا عدّاد يُنقَص: القائمة حُذفت · العدّاد عند الصفر · لم تعد عامة ولا مشارَكة معي · صاحب السجل موقوف (حق الانسحاب)
        return !exists(bmList())
          || get(bmList()).data.get('bookmarkCount', 0) <= 0
          || !(get(bmList()).data.get('public', false) == true || request.auth.uid in get(bmList()).data.get('sharedWith', []))
          || isSuspended()
          || (existsAfter(bmList()) && getAfter(bmList()).data.get('bookmarkCount', 0) == get(bmList()).data.get('bookmarkCount', 0) - 1);
      }
      allow read: if isOwner() || (isSignedIn() && bmOwner() == request.auth.uid);
      allow create: if isSignedIn() && !isSuspended()
