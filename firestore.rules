          && (!('tagline' in request.resource.data) || (request.resource.data.tagline is string && request.resource.data.tagline.size() <= 40))
          && (!('contactUrl' in request.resource.data) || (request.resource.data.contactUrl is string && request.resource.data.contactUrl.matches('https://.*') && request.resource.data.contactUrl.size() <= 300)) // انتقالي
          && (!('contact' in request.resource.data) || (request.resource.data.contact is map
