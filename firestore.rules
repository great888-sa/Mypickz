        && (!('reason' in request.resource.data) || (request.resource.data.reason is string && request.resource.data.reason.size() <= 300)); // v3.17 (١٠): ٣٠٠ — بادئة التطبيق نحو ٥٠ حرفًا فوق ٢٠٠ المستخدم
      allow update: if false;
