      function noPrivateKeys() { // v3.13 (ر٧٣-أ): إغلاق انتقالية M4.26 — الأم بلا categories نهائيًّا (الشكل المقسَّم وحده: الفهرس + مستند لكل تصنيف)
        return !('categories' in request.resource.data);
      }
      function indexOk() { // M4.26 (أ) · v3.13: الفهرس قائمة (≤ ٢٠٠٠٠ مدخل) حين يوجد · splitV == 1 حين يوجد
        return (!('index' in request.resource.data) || (request.resource.data.index is list && request.resource.data.index.size() <= 20000))
