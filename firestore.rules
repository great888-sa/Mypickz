                 && !exists(/databases/$(database)/documents/copies/$(request.auth.uid + '__' + tripId)) && existsAfter(/databases/$(database)/documents/copies/$(request.auth.uid + '__' + tripId))
                 && getAfter(/databases/$(database)/documents/copies/$(request.auth.uid + '__' + tripId)).data.kind == 'trip') // v3.17 (١٥): سجل من نوع العدّاد — وإلا حرّكه سجل من نوع آخر في المسار نفسه
             || (request.resource.data.get('copyCount', 0) == resource.data.get('copyCount', 0) - 1
                 && exists(/databases/$(database)/documents/copies/$(request.auth.uid + '__' + tripId)) && !existsAfter(/databases/$(database)/documents/copies/$(request.auth.uid + '__' + tripId))
                 && get(/databases/$(database)/documents/copies/$(request.auth.uid + '__' + tripId)).data.kind == 'trip'))); // M4.25 (٤) · M4.26 (١) لحظي · v3.10: بالطلب نفسه
      // ⚠️ delete بلا !isSuspended() عمدًا — حق حذف البيانات لا يسقط بالإيقاف (قرار المالك ١٦ أغسطس).
      allow delete: if isOwner()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid);
