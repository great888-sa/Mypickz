             || (request.resource.data.get('bookmarkCount', 0) == resource.data.get('bookmarkCount', 0) - 1
                 && exists(/databases/$(database)/documents/listBookmarks/$(request.auth.uid + '__' + docId)) && !existsAfter(/databases/$(database)/documents/listBookmarks/$(request.auth.uid + '__' + docId)))))); // v3.10: بالطلب نفسه
