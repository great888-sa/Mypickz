    }

    // ===== إصلاح ثغرة ٤ =====
    match /nicknames/{nickId} {
      // v3.17 (٩): القراءة المفردة تبقى عامة (فحص توافر الاسم بالتسجيل يجري قبل المصادقة — doSignUp)؛ السرد أُغلق: كان الزائر يسرد معرّف كل حساب، ولا كود يسرد المجموعة.
      //   المستند حقلان فقط بنوعهما وحدّهما (كان يقبل حقولًا حرّة بلا حدّ وهو مقروء للجميع).
