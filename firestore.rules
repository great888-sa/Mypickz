                 && getAfter(/databases/$(database)/documents/copies/$(request.auth.uid + '__' + docId)).data.kind == 'list') // v3.17 (١٥): سجل من نوع العدّاد — وإلا حرّكه سجل من نوع آخر في المسار نفسه
             || (request.resource.data.get('copyCount', 0) == resource.data.get('copyCount', 0) - 1
