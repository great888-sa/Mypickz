             || request.resource.data.get('viewCount', 0) == resource.data.get('viewCount', 0) + 1) && // M4.26 (٣)
            request.resource.data.get('saveCount', 0) >= 0 &&
            (request.resource.data.get('saveCount', 0) == resource.data.get('saveCount', 0)
             || (request.resource.data.get('saveCount', 0) == resource.data.get('saveCount', 0) + 1
              && !exists(/databases/$(database)/documents/tripSaves/$(request.auth.uid + '__' + tripId)) && existsAfter(/databases/$(database)/documents/tripSaves/$(request.auth.uid + '__' + tripId)))
             || (request.resource.data.get('saveCount', 0) == resource.data.get('saveCount', 0) - 1
              && exists(/databases/$(database)/documents/tripSaves/$(request.auth.uid + '__' + tripId)) && !existsAfter(/databases/$(database)/documents/tripSaves/$(request.auth.uid + '__' + tripId)))) && // v3.10: بالطلب نفسه
            request.resource.data.get('copyCount', 0) >= 0 &&
