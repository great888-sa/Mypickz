// firestore rules v3.6 — المحطة ٢ / الشرط الحاجب (٢٥ أغسطس ٢٠٢٦، أقرّ المالك سطور المصفوفة الثلاثة): v3.5 + ثلاثة قرارات:
//   (١٢) العدّادات العامة لا تنزل تحت الصفر: النقص بواحد مشروط بنتيجة ≥ ٠ — userLists/userCityLists.favoriteCount · communityProfiles.totalFavoriteCount · placeFavoriteCounts.count
//   (٣-ب) فصل الفئات الخاصة: مجموعة جديدة userPrivatePlaces/{uid}_{cityId} — القراءة والإنشاء والتعديل لصاحبها فقط (لا للمالك)، الحذف له وللمالك، الموقوف يقرأ ويحذف فقط؛
//        ومستندات userCityLists لا تقبل مفاتيح الفئات الخاصة السبعة عند الإنشاء، ولا إضافتها عند التعديل (الموروث يبقى حتى يرحّله الكود بأول حفظ) — الخصوصية على مستوى المستند
//   (١) محتوى الموقوف المُشارَك بالاسم: يُحتجز بالكود (sharedWith → sharedWithHeld عند الإيقاف، ويُستعاد عند الرفع) — بلا تغيير قواعد؛ الامتحان يوثّق السلوك
//   ترتيب النشر: هذه القواعد أولًا باللوحة (الوصفة ك) — آمنة على الكود القائم — ثم دفعة الكود (الاحتجاز · تقسيم الحفظ · أرضية العدّادات بالنواة) التي تحتاج المجموعة الجديدة
//   الامتحان: tests/rules-sim.js — ٣٤٣ حالة (٣١٩ + ٢٤) بنفس الكوميت
// firestore rules v3.5 — المحطة ٢ / الشرط الحاجب (٢٤ أغسطس ٢٠٢٦، وقّعه المالك): v3.4 + تقييد معرّف userCityLists عند الإنشاء
//   (docId يبدأ بمعرّف منشئه: split('_')[0] == uid — الكود يكتبه uid_cityId أصلًا: الدالة myCityListDocId) — يغلق انتحال البادئة owner_ من الجذر
//   (كان مدافَعًا عنه عند القراءة فقط بـv3.3.1)؛ إنشاء فقط — المستندات القائمة لا تُمس. الامتحان: ٣١٩ حالة (٣١٣ + ٣١٤..٣١٩) بنفس الكوميت
//   قرارا سلوك موقَّعان بلا تغيير قواعد: بقاء سجل الإيقاف بعد الحذف الذاتي (+سطر إفصاح بالسياسة) · إنقاص عدّادات المفضلة بمسار الحذف
// firestore rules v3.4 — قرارات الأعلام (٢١ أغسطس ٢٠٢٦، اعتمدها المالك عبر الشرط الحاجب — المصفوفة M4): v3.3.1 + أربعة تضييقات:
//   (M-P3) placeFavoriteCounts: الاسم والرابط يتجمدان بعد الإنشاء — التحديث لحقل count حصرًا (±١)؛ التصحيح لمالك التطبيق (فرع isOwner جديد بالتحديث)
//   (M-P4) placeFavoriteCounts: الإنشاء بالحقول الثلاثة كاملة (hasAll) — لا بطاقات ناقصة
//   (M-P5) communityProfiles: المُوقَف لا ينشئ/يعدّل ملفه المجتمعي (القراءة والحذف باقيان — حق الانسحاب)
//   (M-P7) dailyStats: الإنشاء بقيم بداية ٠..١ لكل حقل — لا بذر بأرقام ضخمة أو سالبة
//   المُقر بلا تغيير (M-P1/P2/P6): القياس والعدّادات المجهولة لا تُحجب بالإيقاف · المالك يدير ولا ينتحل
//   الامتحان: tests/rules-sim.js — ٣١٣ حالة (تُنشر بنفس commit هذا الملف إلزامًا)
// firestore rules v3.3.1 — أ-٣ الطبقة ٣ (١٩ أغسطس ٢٠٢٦): v3.3 + (١) stats_places يقبل أماكن دليل المالك بمعرّف owner_{city}__{hash} (مدينة حقيقية، القراءة للمالك فقط حتى لو زُوِّر userCityLists/owner_*)
//   + (٢) أحداث الاستيراد (ب-١) محجوزة الآن: import_run · import_place · import_suggest_kept · import_suggest_changed · reserved_1 = نشر عام (toggle public) · reserved_2/3 احتياط
//   + (٣) العناوين الشخصية (خاصة دائمًا — لا كيان ولا بصمة ولا مدينة): personal_open · personal_save · personal_place_open بالتجميع اليومي فقط بمدينة all
// firestore rules v3.3 — أ-٣ الطبقة ٣ "قاعدة القياس" (١٩ أغسطس ٢٠٢٦): v3.2 + ثلاث طبقات قياس مجهول الهوية:
//   (ج) analytics/errors_*  (ب) analytics/events_* · sources_* · hours_* · sessions_*  (أ) stats_lists · stats_trips · stats_places · stats_curators · stats_cards
//   الكتابة مجمَّعة بلا مصادقة بنمط visits (حقول من قائمة مغلقة، زيادة ١..٥٠ لكل حقل — الثواني ١..٧٢٠٠، لا إنقاص، لا حذف) — الحارس الجذري App Check (الطبقة ٤)
//   القراءة: (ب)(ج) للمالك فقط · (أ) لصاحب الكيان + المالك · لا حقل هوية بأي مستند · كل الأسماء محجوزة الآن (لا نشرة جديدة عند تفعيل وظائف ج-١أ/ب-١)
// v3.2 — أ-٣ الطبقة ١-ب (١٩ أغسطس ٢٠٢٦): v3.1 + (١) isOwner() على قراءة favorites (اتساق مع users/trips/userCityLists)
//   + (٢) المُوقَف لا يعدّل users/{uid} ولا ينشئ/يعدّل nicknames (الحذف يبقى — حق حذف البيانات لا يسقط بالإيقاف)
//   المصدر السابق v3.1: أ-٢ الدفعة ٣ (١٧ أغسطس ٢٠٢٦): v2 + suspensions/{uid} + توحيد نمط الحذف + isOwner() على قراءة trips/userCityLists
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/settings/app).data.ownerUid == request.auth.uid;
    }
    // ⚠️ تُستخدَم على الكتابة فقط — لا تُضاف لأي قاعدة read إطلاقًا (سبب حادثة النقطة ١٥)
    // v3: علم الإيقاف انتقل من users/{uid}.suspended (يملكه المستخدم ⇒ ثغرة الرفع الذاتي بحذف مستنده)
    //     إلى suspensions/{uid} (يكتبه المالك حصرًا). وجود المستند = إيقاف. قراءة واحدة بدل اثنتين.
    function isSuspended() {
      return exists(/databases/$(database)/documents/suspensions/$(request.auth.uid));
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /cities/{cityId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // ===== v3: سجل الإيقاف — ملكية المالك حصرًا =====
    // القراءة مقيَّدة بالمالك وصاحب الشأن (get/exists داخل القواعد لا تخضع لقواعد read، فالتقييد لا يكسر isSuspended)
    match /suspensions/{uid} {
      allow read: if isOwner() || (isSignedIn() && request.auth.uid == uid);
      allow write: if isOwner();
    }

    // ===== إصلاح ثغرة ٢ =====
    // ⚠️ لا يُقيَّد بـisSignedIn() إطلاقًا: trackVisit() تُستدعى قبل استعادة جلسة المصادقة
    //    (سطر ~3660) فيكون request.auth == null حتى للمستخدم المسجَّل — التقييد بالهوية
    //    يوقف العدّاد صامتًا (الدالة ملفوفة بـcatch فاضي).
    // الحل: تقييد البنية والسلوك بدل الهوية — زيادة بمقدار ١ فقط على حقل count بمستند visits.
    // ===== v3.3 (أ-٣ الطبقة ٣): مصيدة الأخطاء + سجل الأحداث المجهول =====
    // errors_{YYYY-MM-DD}: عدّادات بنوع الخطأ فقط (لا رسائل، لا بيانات شخصية).
    // events_{YYYY-MM-DD}__{city}__{category}: عدّادات أحداث مجهولة الهوية (المدينة حقيقية أو 'all'، الفئة ≤ ٤٠ حرفًا أو 'all').
    // الكتابة بلا مصادقة (كـvisits) لأن الزائر غير المسجَّل يولّد أحداثًا أيضًا؛ الحارس الجذري هو App Check (الطبقة ٤).
    // القراءة للمالك فقط (قرار المالك ١٩ أغسطس) — أرقام صحة المشروع وحجمه بيانات داخلية. visits يبقى عامًّا (يُعرض أصلًا).
    // الأحداث محجوزة كاملة الآن حتى لا تُعاد نشرة عند تفعيل وظائفها لاحقًا (ج-١أ: share_card, curator_*, signup_*, visit_source · ب-١: import_*) · reserved_1 = نشر عام.
    function isErrorsDoc(id) { return id.matches('errors_[0-9]{4}-[0-9]{2}-[0-9]{2}'); }
    function isEventsDoc(id) { return id.matches('events_[0-9]{4}-[0-9]{2}-[0-9]{2}__[a-z0-9_-]{1,40}__[a-z0-9_-]{1,40}'); }
    function isSourcesDoc(id) { return id.matches('sources_[0-9]{4}-[0-9]{2}-[0-9]{2}__[a-z0-9_-]{1,40}'); }
    function isHoursDoc(id) { return id.matches('hours_[0-9]{4}-[0-9]{2}-[0-9]{2}__[a-z0-9_-]{1,40}'); }
    function isSessionsDoc(id) { return id.matches('sessions_[0-9]{4}-[0-9]{2}-[0-9]{2}__[a-z0-9_-]{1,40}'); }
    function isOwnerOnlyAnalytics(id) { return isErrorsDoc(id) || isEventsDoc(id) || isSourcesDoc(id) || isHoursDoc(id) || isSessionsDoc(id); }
    function cityOk(id) {
      return id.split('__')[1] == 'all'
        || exists(/databases/$(database)/documents/cities/$(id.split('__')[1]));
    }
    // إنشاء: كل حقل موجود عدد صحيح بين ١ و٥٠. تحديث: كل حقل متأثر زاد بين ١ و٥٠ (بلا إنقاص، بلا حذف حقول، بلا حقول غريبة).
    function bumpC(k) {
      return !(k in request.resource.data)
        || (request.resource.data[k] is int && request.resource.data[k] >= 1 && request.resource.data[k] <= 50);
    }
    function bumpU(k) {
      return !(k in request.resource.data.diff(resource.data).affectedKeys())
        || (request.resource.data[k] is int
            && request.resource.data[k] - resource.data.get(k, 0) >= 1
            && request.resource.data[k] - resource.data.get(k, 0) <= 50);
    }
    // الثواني (مجموع مدة الجلسات): حد أعلى ٧٢٠٠ لكل كتابة
    function bumpCBig(k) {
      return !(k in request.resource.data)
        || (request.resource.data[k] is int && request.resource.data[k] >= 1 && request.resource.data[k] <= 7200);
    }
    function bumpUBig(k) {
      return !(k in request.resource.data.diff(resource.data).affectedKeys())
        || (request.resource.data[k] is int
            && request.resource.data[k] - resource.data.get(k, 0) >= 1
            && request.resource.data[k] - resource.data.get(k, 0) <= 7200);
    }
    function errorKeysOk() {
      return request.resource.data.keys().hasOnly(['TypeError', 'ReferenceError', 'SyntaxError', 'NetworkError', 'UnhandledRejection', 'Other', 'total']) && request.resource.data.keys().size() >= 1;
    }
    function eventKeysOk() {
      return request.resource.data.keys().hasOnly(['visit_source', 'signup_start', 'signup_done', 'place_open', 'favorites_open', 'favorite_add', 'mylist_open', 'mylist_save', 'trip_open', 'trip_save', 'community_open', 'share_link', 'share_card', 'curator_view', 'curator_contact', 'curator_follow', 'session_depth', 'import_run', 'import_place', 'import_suggest_kept', 'import_suggest_changed', 'personal_open', 'personal_save', 'personal_place_open', 'reserved_1', 'reserved_2', 'reserved_3'])
        && request.resource.data.keys().size() >= 1;
    }
    function errorsCreateOk() {
      return errorKeysOk()
        && bumpC('TypeError')
        && bumpC('ReferenceError')
        && bumpC('SyntaxError')
        && bumpC('NetworkError')
        && bumpC('UnhandledRejection')
        && bumpC('Other')
        && bumpC('total');
    }
    function errorsUpdateOk() {
      return errorKeysOk()
        && request.resource.data.diff(resource.data).affectedKeys().size() >= 1
        && bumpU('TypeError')
        && bumpU('ReferenceError')
        && bumpU('SyntaxError')
        && bumpU('NetworkError')
        && bumpU('UnhandledRejection')
        && bumpU('Other')
        && bumpU('total');
    }
    function eventsCreateOk() {
      return eventKeysOk()
        && bumpC('visit_source')
        && bumpC('signup_start')
        && bumpC('signup_done')
        && bumpC('place_open')
        && bumpC('favorites_open')
        && bumpC('favorite_add')
        && bumpC('mylist_open')
        && bumpC('mylist_save')
        && bumpC('trip_open')
        && bumpC('trip_save')
        && bumpC('community_open')
        && bumpC('share_link')
        && bumpC('share_card')
        && bumpC('curator_view')
        && bumpC('curator_contact')
        && bumpC('curator_follow')
        && bumpC('session_depth')
        && bumpC('import_run')
        && bumpC('import_place')
        && bumpC('import_suggest_kept')
        && bumpC('import_suggest_changed')
        && bumpC('personal_open')
        && bumpC('personal_save')
        && bumpC('personal_place_open')
        && bumpC('reserved_1')
        && bumpC('reserved_2')
        && bumpC('reserved_3');
    }
    function eventsUpdateOk() {
      return eventKeysOk()
        && request.resource.data.diff(resource.data).affectedKeys().size() >= 1
        && bumpU('visit_source')
        && bumpU('signup_start')
        && bumpU('signup_done')
        && bumpU('place_open')
        && bumpU('favorites_open')
        && bumpU('favorite_add')
        && bumpU('mylist_open')
        && bumpU('mylist_save')
        && bumpU('trip_open')
        && bumpU('trip_save')
        && bumpU('community_open')
        && bumpU('share_link')
        && bumpU('share_card')
        && bumpU('curator_view')
        && bumpU('curator_contact')
        && bumpU('curator_follow')
        && bumpU('session_depth')
        && bumpU('import_run')
        && bumpU('import_place')
        && bumpU('import_suggest_kept')
        && bumpU('import_suggest_changed')
        && bumpU('personal_open')
        && bumpU('personal_save')
        && bumpU('personal_place_open')
        && bumpU('reserved_1')
        && bumpU('reserved_2')
        && bumpU('reserved_3');
    }

    function sourcesKeysOk() { return request.resource.data.keys().hasOnly(['src_app', 'src_ulist', 'src_trip', 'src_community', 'src_curator', 'ref_ig', 'ref_tt', 'ref_sc', 'ref_card', 'ref_qr', 'ref_link', 'ref_direct']) && request.resource.data.keys().size() >= 1; }
    function sourcesCreateOk() { return sourcesKeysOk() && bumpC('src_app')
        && bumpC('src_ulist')
        && bumpC('src_trip')
        && bumpC('src_community')
        && bumpC('src_curator')
        && bumpC('ref_ig')
        && bumpC('ref_tt')
        && bumpC('ref_sc')
        && bumpC('ref_card')
        && bumpC('ref_qr')
        && bumpC('ref_link')
        && bumpC('ref_direct'); }
    function sourcesUpdateOk() { return sourcesKeysOk() && request.resource.data.diff(resource.data).affectedKeys().size() >= 1 && bumpU('src_app')
        && bumpU('src_ulist')
        && bumpU('src_trip')
        && bumpU('src_community')
        && bumpU('src_curator')
        && bumpU('ref_ig')
        && bumpU('ref_tt')
        && bumpU('ref_sc')
        && bumpU('ref_card')
        && bumpU('ref_qr')
        && bumpU('ref_link')
        && bumpU('ref_direct'); }
    function hoursKeysOk() { return request.resource.data.keys().hasOnly(['h00', 'h01', 'h02', 'h03', 'h04', 'h05', 'h06', 'h07', 'h08', 'h09', 'h10', 'h11', 'h12', 'h13', 'h14', 'h15', 'h16', 'h17', 'h18', 'h19', 'h20', 'h21', 'h22', 'h23']) && request.resource.data.keys().size() >= 1; }
    function hoursCreateOk() { return hoursKeysOk() && bumpC('h00')
        && bumpC('h01')
        && bumpC('h02')
        && bumpC('h03')
        && bumpC('h04')
        && bumpC('h05')
        && bumpC('h06')
        && bumpC('h07')
        && bumpC('h08')
        && bumpC('h09')
        && bumpC('h10')
        && bumpC('h11')
        && bumpC('h12')
        && bumpC('h13')
        && bumpC('h14')
        && bumpC('h15')
        && bumpC('h16')
        && bumpC('h17')
        && bumpC('h18')
        && bumpC('h19')
        && bumpC('h20')
        && bumpC('h21')
        && bumpC('h22')
        && bumpC('h23'); }
    function hoursUpdateOk() { return hoursKeysOk() && request.resource.data.diff(resource.data).affectedKeys().size() >= 1 && bumpU('h00')
        && bumpU('h01')
        && bumpU('h02')
        && bumpU('h03')
        && bumpU('h04')
        && bumpU('h05')
        && bumpU('h06')
        && bumpU('h07')
        && bumpU('h08')
        && bumpU('h09')
        && bumpU('h10')
        && bumpU('h11')
        && bumpU('h12')
        && bumpU('h13')
        && bumpU('h14')
        && bumpU('h15')
        && bumpU('h16')
        && bumpU('h17')
        && bumpU('h18')
        && bumpU('h19')
        && bumpU('h20')
        && bumpU('h21')
        && bumpU('h22')
        && bumpU('h23'); }
    function sessionsKeysOk() { return request.resource.data.keys().hasOnly(['count', 'seconds', 'depth']) && request.resource.data.keys().size() >= 1; }
    function sessionsCreateOk() { return sessionsKeysOk() && bumpC('count') && bumpCBig('seconds') && bumpC('depth'); }
    function sessionsUpdateOk() { return sessionsKeysOk() && request.resource.data.diff(resource.data).affectedKeys().size() >= 1 && bumpU('count') && bumpUBig('seconds') && bumpU('depth'); }
    // المدينة بمعرّفات المستندات اليومية: حقيقية أو 'all'
    function cityOk2(id) {
      return id.split('__')[1] == 'all'
        || exists(/databases/$(database)/documents/cities/$(id.split('__')[1]));
    }

    match /analytics/{docId} {
      allow read: if !isOwnerOnlyAnalytics(docId) || isOwner();
      allow create: if (docId == 'visits'
          && request.resource.data.keys().hasOnly(['count'])
          && request.resource.data.count == 1)
        || (isErrorsDoc(docId) && errorsCreateOk())
        || (isEventsDoc(docId) && cityOk(docId) && eventsCreateOk())
        || (isSourcesDoc(docId) && cityOk2(docId) && sourcesCreateOk())
        || (isHoursDoc(docId) && cityOk2(docId) && hoursCreateOk())
        || (isSessionsDoc(docId) && cityOk2(docId) && sessionsCreateOk());
      allow update: if (docId == 'visits'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
          && request.resource.data.count == resource.data.count + 1)
        || (isErrorsDoc(docId) && errorsUpdateOk())
        || (isEventsDoc(docId) && cityOk(docId) && eventsUpdateOk())
        || (isSourcesDoc(docId) && cityOk2(docId) && sourcesUpdateOk())
        || (isHoursDoc(docId) && cityOk2(docId) && hoursUpdateOk())
        || (isSessionsDoc(docId) && cityOk2(docId) && sessionsUpdateOk());
      allow delete: if false;
    }

    // ===== إصلاح ثغرة ٣ (أ) =====
    // عدّاد تراكمي قديم — زيادة بمقدار ١ فقط، لا حذف، لا حقول جديدة
    match /stats/{docId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if isOwner();
    }

    // ===== إصلاح ثغرة ٣ (ب) =====
    // يكتبه الكود بـ{name, url, count:±1} — نقيّد الحقول والمقدار معًا
    // + إضافة !isSuspended(): المستخدم المُوقَف لا يؤثر على عدّادات Most Loved
    match /placeFavoriteCounts/{docId} {
      allow read: if true;
      // v3.4 (M-P4): الإنشاء بالحقول الثلاثة كاملة إلزامًا — لا بطاقات ناقصة (hasAll + hasOnly)
      allow create: if isSignedIn() && !isSuspended()
        && request.resource.data.keys().hasAll(['name','url','count'])
        && request.resource.data.keys().hasOnly(['name','url','count'])
        && request.resource.data.count == 1;
      // v3.4 (M-P3): الاسم والرابط يتجمدان بعد الإنشاء — التحديث يمس حقل العدّاد حصرًا؛
      //   تصحيحهما لمالك التطبيق وحده (فرع isOwner). يغلق إعادة التسمية واختطاف الرابط.
      // الزيادة (+1) تتطلب حسابًا غير مُوقَف؛ الإنقاص (-1) مسموح للمُوقَف أيضًا
      // (يستطيع سحب إعجابه أو حذف حسابه، لا إضافة إعجاب جديد) — قرار المالك ١٦ أغسطس
      // v3.6 (١٢): النقص لا ينزل تحت الصفر
      allow update: if isOwner()
        || (isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
          && ((!isSuspended() && request.resource.data.count == resource.data.count + 1)
              || (request.resource.data.count == resource.data.count - 1 && request.resource.data.count >= 0)));
      allow delete: if isOwner();
    }

    // v3: توحيد نمط الحذف — إنشاء/تعديل تتطلب غير مُوقَف؛ الحذف يتطلب الملكية فقط (حق حذف البيانات لا يسقط بالإيقاف)
    match /favorites/{userId} {
      // v3.2: + isOwner() على القراءة — اتساقًا مع users/trips/userCityLists (لم يكن للاختلاف سبب تصميمي)
      allow read: if isOwner() || (isSignedIn() && request.auth.uid == userId);
      allow create, update: if isSignedIn() && request.auth.uid == userId && !isSuspended();
      allow delete: if isOwner() || (isSignedIn() && request.auth.uid == userId);
    }

    match /userLists/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || resource.data.public == true);
      // v3: الحذف مفصول — نفس المبرر
      allow delete: if isOwner() || (isSignedIn() && request.auth.uid == userId);
      allow create, update: if isOwner()
        || (isSignedIn() && request.auth.uid == userId && !isSuspended())
        // تقييد المقدار بـ±١ (تدقيق شامل ١٦ أغسطس) — مسار قديم، يبقى محميًا احتياطًا · v3.6 (١٢): النتيجة ≥ ٠
        || (isSignedIn() && !isSuspended() && resource.data.public == true &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favoriteCount']) &&
            request.resource.data.favoriteCount >= 0 &&
            (request.resource.data.favoriteCount == resource.data.get('favoriteCount', 0) + 1
             || request.resource.data.favoriteCount == resource.data.get('favoriteCount', 0) - 1));
    }

    // ===== إصلاح ثغرة ٥ (أ) + التعارض المكتشَف =====
    // ١) إضافة isOwner() لـupdate/delete — كان موثَّقًا كمُصلَح لكنه غير موجود بالمنشور فعليًا،
    //    وبدونه لا يستطيع المالك كتابة حقل suspended على رحلات المستخدمين (إصلاح النقطة ١٤ معطَّل عمليًا)
    // ٢) إضافة !isSuspended() على الكتابة فقط — لا على القراءة (تفاديًا لحادثة النقطة ١٥)
    match /trips/{tripId} {
      // v3.1: + isOwner() على القراءة — toggleSuspendUser تستعلم عن رحلات المستخدم المُوقَف (where ownerId==uid)
      //       والاستعلام يُرفض بلا هذا. توسيع للمالك فقط (يقرأ كل شيء بـConsole أصلًا) — ليس تكرارًا للنقطة ١٥.
      allow read: if isOwner() || (isSignedIn() && (resource.data.ownerId == request.auth.uid
        || resource.data.public == true
        || request.auth.uid in resource.data.sharedWith));
      allow create: if isSignedIn() && !isSuspended()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isOwner()
        || (isSignedIn() && !isSuspended() && resource.data.ownerId == request.auth.uid);
      // ⚠️ delete بلا !isSuspended() عمدًا — حق حذف البيانات لا يسقط بالإيقاف (قرار المالك ١٦ أغسطس).
      //    أثر جانبي مقبول وموثَّق: المُوقَف يقدر يحذف رحلاته فرادى، لا ضمن حذف الحساب فقط.
      allow delete: if isOwner()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    // ===== إصلاح ثغرة ٥ (ب) =====
    // نفس المبدأ: isSuspended() على الكتابة حصرًا + إعادة isOwner() للإدارة
    match /userCityLists/{docId} {
      // v3.1: + isOwner() على القراءة — نفس مبرر trips (كان سبب "Could not update user" عند الإيقاف)
      allow read: if isOwner() || (isSignedIn() && (resource.data.ownerId == request.auth.uid
        || resource.data.public == true
        || request.auth.uid in resource.data.sharedWith));
      // v3.5: المعرّف يبدأ بمعرّف منشئه إلزامًا (uid لا يحوي شرطة سفلية — أول مقطع قبل '_' هو المنشئ حصرًا)
      //   يغلق انتحال owner_ وأي بادئة غير ذاتية عند المنشأ؛ إنشاء فقط — القائم لا يُمس
      // v3.6 (٣-ب): مفاتيح الفئات الخاصة السبعة لا تدخل مستند قائمة قابل للنشر — مكانها userPrivatePlaces.
      //   تُفحص عند الإنشاء دائمًا؛ وعند التعديل تُرفض المفاتيح المضافة فقط (الموروث يبقى حتى يرحّله الكود بأول حفظ) — عدّادات القوائم القائمة لا تتأثر.
      //   المفاتيح المخصصة داخل الأقسام الخاصة يحكمها الكود (لا تكرار بالقواعد — لا وسيلة لفحص بادئة عبر المفاتيح).
      function noPrivateKeys() {
        return !request.resource.data.get('categories', {}).keys().hasAny(['hospitals_clinics', 'personal_home', 'personal_work', 'personal_family', 'personal_relatives', 'personal_friends', 'others']);
      }
      // عند التعديل: يُرفض ما يُضاف من مفاتيح خاصة فقط (addedKeys) — الموروث بالقوائم القائمة يبقى حتى يرحّله الكود بأول حفظ،
      //   فتكون هذه القواعد آمنة على الكود القائم وتُنشر قبل دفعة الكود لا بعدها.
      function privateKeysOkOnUpdate() {
        return !('categories' in request.resource.data.diff(resource.data).affectedKeys())
          || !('categories' in request.resource.data)
          || !request.resource.data.categories.diff(resource.data.get('categories', {})).addedKeys().hasAny(['hospitals_clinics', 'personal_home', 'personal_work', 'personal_family', 'personal_relatives', 'personal_friends', 'others']);
      }
      allow create: if isSignedIn() && !isSuspended()
        && request.resource.data.ownerId == request.auth.uid
        && docId.split('_')[0] == request.auth.uid
        && noPrivateKeys();
      allow update: if privateKeysOkOnUpdate() && (isOwner()
        || (isSignedIn() && !isSuspended() && resource.data.ownerId == request.auth.uid)
        // ===== إصلاح ثغرة ٣ الموسَّعة (تدقيق شامل ١٦ أغسطس): تقييد المقدار بـ±١ · v3.6 (١٢): النتيجة ≥ ٠ =====
        // كانت تسمح بأي مقدار (مثل favoriteCount: 999999) ⇒ إفساد ترتيب Community Lists
        || (isSignedIn() && !isSuspended() && resource.data.public == true &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favoriteCount']) &&
            request.resource.data.favoriteCount >= 0 &&
            (request.resource.data.favoriteCount == resource.data.get('favoriteCount', 0) + 1
             || request.resource.data.favoriteCount == resource.data.get('favoriteCount', 0) - 1)));
      // ⚠️ delete بلا !isSuspended() عمدًا — نفس مبرر trips أعلاه
      allow delete: if isOwner()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /communityProfiles/{uid} {
      allow read: if true;
      // v3.4 (M-P5): المُوقَف لا ينشئ ولا يعدّل ملفه المجتمعي (أسوة بحسابه واسمه المستعار — اتساق v3.2)؛
      //   القراءة والحذف يبقيان له (حق الانسحاب الكامل لا يسقط بالإيقاف)
      allow create: if isOwner() || (isSignedIn() && request.auth.uid == uid && !isSuspended());
      allow delete: if isOwner() || (isSignedIn() && request.auth.uid == uid);
      allow update: if isOwner()
        || (isSignedIn() && request.auth.uid == uid && !isSuspended())
        // ===== إصلاح ثغرة ٣ الموسَّعة: تقييد المقدار بـ±١ لكل عدّاد =====
        // كانت تسمح بأي مقدار ⇒ تضخيم المشاهدات/الإعجابات بلا حد
        || (isSignedIn() && !isSuspended() && resource.data.hasAnyPublicContent == true &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount','totalFavoriteCount']) &&
            (request.resource.data.get('viewCount', 0) == resource.data.get('viewCount', 0)
             || request.resource.data.get('viewCount', 0) == resource.data.get('viewCount', 0) + 1) &&
            request.resource.data.get('totalFavoriteCount', 0) >= 0 &&
            (request.resource.data.get('totalFavoriteCount', 0) == resource.data.get('totalFavoriteCount', 0)
             || request.resource.data.get('totalFavoriteCount', 0) == resource.data.get('totalFavoriteCount', 0) + 1
             || request.resource.data.get('totalFavoriteCount', 0) == resource.data.get('totalFavoriteCount', 0) - 1));
    }

    // ===== v3.6 (٣-ب): الفئات الخاصة — مجموعة مستقلة، الخصوصية على مستوى المستند =====
    // userPrivatePlaces/{uid}_{cityId}: الفئات الخاصة (مستشفيات وعيادات · شخصي · أخرى · العناوين الشخصية) لصاحبها وحده.
    // لا علم public ولا sharedWith أصلًا. مالك التطبيق: حذف فقط (حذف الحساب والإساءة) — لا قراءة ولا تعديل (وعد السياسة).
    // الموقوف: قراءة وحذف (حق الانسحاب) — لا إنشاء ولا تعديل. الملكية بالمعرّف لا بحقل يُكتب.
    match /userPrivatePlaces/{docId} {
      function isMine() { return isSignedIn() && docId.split('_')[0] == request.auth.uid; }
      allow read: if isMine();
      allow create: if isMine() && !isSuspended();
      allow update: if isMine() && !isSuspended();
      allow delete: if isOwner() || isMine();
    }

    // ===== إصلاح ثغرة ٤ =====
    // الثغرة: القاعدة القديمة تفحص resource.data.uid (القيمة الحالية) فقط، ولا تفحص
    //         request.resource.data.uid (القيمة الجديدة) — فيقدر أي مستخدم ينشئ اسمًا
    //         مستعارًا وينسبه لحساب شخص آخر.
    // الحل: فصل create/update/delete + فحص القيمة الجديدة صراحةً بالحالتين
    match /nicknames/{nickId} {
      allow read: if true;
      // v3.2: + !isSuspended() على الإنشاء/التعديل — المُوقَف لا يغيّر اسمه المستعار (قرار المالك ١٩ أغسطس)
      allow create: if isSignedIn() && !isSuspended()
        && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && !isSuspended()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isOwner()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // ===== إصلاح ثغرة ١ =====
    // غياب delete تمامًا = منعه تلقائيًا: لا المالك ولا المستخدم نفسه يقدر يحذف حسابًا،
    // ولو بطلب صريح — فجوة قانونية فعلية (حق حذف البيانات).
    // ⚠️ هذا يفتح الصلاحية فقط. واجهة "احذف حسابي" والحذف المتتالي عبر المجموعات السبع
    //    تُنفَّذ بالمرحلة أ-٢ مع سياسة الخصوصية (قرار موثَّق).
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isOwner());
      allow create: if isSignedIn() && request.auth.uid == userId;
      // v3: أُزيل شرط "suspended لا يتغير" — الحقل لم يعد مصدر الحقيقة (انتقل إلى suspensions/{uid})،
      //     وبقاؤه كان سيرفض تحديثات المستخدم لنفسه بعد اختفاء الحقل من المستندات الجديدة
      // v3.2: + !isSuspended() على تعديل المستخدم لنفسه — المُوقَف لا يعدّل بياناته (قرار المالك ١٩ أغسطس)؛ الحذف يبقى
      allow update: if isOwner() || (isSignedIn() && request.auth.uid == userId && !isSuspended());
      allow delete: if isOwner() || (isSignedIn() && request.auth.uid == userId);
    }

    // ===== إصلاح ثغرة ٣ (ج) =====
    // العدّادات اليومية: الحقول محدَّدة، والقيم لا تنقص أبدًا (منع التصفير/التخريب)
    match /dailyStats/{date} {
      allow read: if isOwner();
      // v3.4 (M-P7): قيم البداية ٠ أو ١ حصرًا لكل حقل (تعميم نمط visits) — يمنع بذر يوم بأرقام ضخمة/سالبة
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['newSignupsToday','activeToday'])
        && request.resource.data.get('newSignupsToday', 0) >= 0
        && request.resource.data.get('newSignupsToday', 0) <= 1
        && request.resource.data.get('activeToday', 0) >= 0
        && request.resource.data.get('activeToday', 0) <= 1;
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['newSignupsToday','activeToday'])
        && request.resource.data.get('activeToday', 0) >= resource.data.get('activeToday', 0)
        && request.resource.data.get('newSignupsToday', 0) >= resource.data.get('newSignupsToday', 0);
      allow delete: if isOwner();
    }


    // ===== v3.3 (أ) عدّادات الكيانات — stats_lists =====
    // معرّف القائمة (userCityLists) أو معرّف القائمة__يوم · القراءة لصاحب القائمة + المالك · الإنشاء فقط لقائمة موجودة فعلًا
    match /stats_lists/{docId} {
      function keysOk() { return request.resource.data.keys().hasOnly(['open_ulist', 'open_community', 'open_curator', 'open_trip', 'open_direct', 'open_total', 'save_from', 'copy_from', 'place_open_total']) && request.resource.data.keys().size() >= 1; }
      function createOk() { return keysOk() && bumpC('open_ulist')
        && bumpC('open_community')
        && bumpC('open_curator')
        && bumpC('open_trip')
        && bumpC('open_direct')
        && bumpC('open_total')
        && bumpC('save_from')
        && bumpC('copy_from')
        && bumpC('place_open_total'); }
      function updateOk() { return keysOk() && request.resource.data.diff(resource.data).affectedKeys().size() >= 1 && bumpU('open_ulist')
        && bumpU('open_community')
        && bumpU('open_curator')
        && bumpU('open_trip')
        && bumpU('open_direct')
        && bumpU('open_total')
        && bumpU('save_from')
        && bumpU('copy_from')
        && bumpU('place_open_total'); }
      allow read: if isOwner() || (isSignedIn() && exists(/databases/$(database)/documents/userCityLists/$(docId.split('__')[0])) && get(/databases/$(database)/documents/userCityLists/$(docId.split('__')[0])).data.ownerId == request.auth.uid);
      allow create: if docId.matches('[A-Za-z0-9_-]{1,60}(__[0-9]{4}-[0-9]{2}-[0-9]{2})?') && exists(/databases/$(database)/documents/userCityLists/$(docId.split('__')[0])) && createOk();
      allow update: if docId.matches('[A-Za-z0-9_-]{1,60}(__[0-9]{4}-[0-9]{2}-[0-9]{2})?') && exists(/databases/$(database)/documents/userCityLists/$(docId.split('__')[0])) && updateOk();
      allow delete: if isOwner();
    }
    // ===== v3.3 (أ) عدّادات الكيانات — stats_trips =====
    // معرّف الرحلة (trips) أو معرّف الرحلة__يوم · القراءة لصاحب الرحلة + المالك
    match /stats_trips/{docId} {
      function keysOk() { return request.resource.data.keys().hasOnly(['view_shared', 'view_community', 'view_curator', 'view_direct', 'view_total', 'copy', 'interested']) && request.resource.data.keys().size() >= 1; }
      function createOk() { return keysOk() && bumpC('view_shared')
        && bumpC('view_community')
        && bumpC('view_curator')
        && bumpC('view_direct')
        && bumpC('view_total')
        && bumpC('copy')
        && bumpC('interested'); }
      function updateOk() { return keysOk() && request.resource.data.diff(resource.data).affectedKeys().size() >= 1 && bumpU('view_shared')
        && bumpU('view_community')
        && bumpU('view_curator')
        && bumpU('view_direct')
        && bumpU('view_total')
        && bumpU('copy')
        && bumpU('interested'); }
      allow read: if isOwner() || (isSignedIn() && exists(/databases/$(database)/documents/trips/$(docId.split('__')[0])) && get(/databases/$(database)/documents/trips/$(docId.split('__')[0])).data.ownerId == request.auth.uid);
      allow create: if docId.matches('[A-Za-z0-9_-]{1,60}(__[0-9]{4}-[0-9]{2}-[0-9]{2})?') && exists(/databases/$(database)/documents/trips/$(docId.split('__')[0])) && createOk();
      allow update: if docId.matches('[A-Za-z0-9_-]{1,60}(__[0-9]{4}-[0-9]{2}-[0-9]{2})?') && exists(/databases/$(database)/documents/trips/$(docId.split('__')[0])) && updateOk();
      allow delete: if isOwner();
    }
    // ===== v3.3 (أ) عدّادات الكيانات — stats_places =====
    // معرّف القائمة__بصمة الرابط (١٦ خانة سداسية تُحسب بالمتصفح — لا رابط نصًّا) · مدى الحياة فقط · القراءة لصاحب القائمة + المالك · تُرحَّل إلى معرّف المكان بب-١
    // v3.3.1: + أماكن دليل المالك بمعرّف owner_{city}__{hash} — المدينة يجب أن تكون حقيقية (cities)، لا مستند userCityLists؛ قراءتها للمالك (isOwner بقاعدة القراءة)
    match /stats_places/{docId} {
      function keysOk() { return request.resource.data.keys().hasOnly(['open_app', 'open_ulist', 'open_trip', 'open_community', 'open_curator', 'open_total', 'save_from', 'trip_add']) && request.resource.data.keys().size() >= 1; }
      function createOk() { return keysOk() && bumpC('open_app')
        && bumpC('open_ulist')
        && bumpC('open_trip')
        && bumpC('open_community')
        && bumpC('open_curator')
        && bumpC('open_total')
        && bumpC('save_from')
        && bumpC('trip_add'); }
      function updateOk() { return keysOk() && request.resource.data.diff(resource.data).affectedKeys().size() >= 1 && bumpU('open_app')
        && bumpU('open_ulist')
        && bumpU('open_trip')
        && bumpU('open_community')
        && bumpU('open_curator')
        && bumpU('open_total')
        && bumpU('save_from')
        && bumpU('trip_add'); }
      // v3.3.1: المعرّفات owner_* يقرؤها المالك فقط — ولو أنشأ مستخدم مستند userCityLists باسم owner_{city} (معرّفات userCityLists غير مقيَّدة بالقواعد القديمة) فلا يكسب قراءتها
      allow read: if isOwner() || (isSignedIn() && !docId.matches('owner_.*') && exists(/databases/$(database)/documents/userCityLists/$(docId.split('__')[0])) && get(/databases/$(database)/documents/userCityLists/$(docId.split('__')[0])).data.ownerId == request.auth.uid);
      function ownerPlaceOk() {
        return docId.matches('owner_[a-z0-9_-]{1,40}__[a-f0-9]{16}')
          && exists(/databases/$(database)/documents/cities/$(docId.split('__')[0].split('owner_')[1]));
      }
      function userPlaceOk() {
        return docId.matches('[A-Za-z0-9_-]{1,60}__[a-f0-9]{16}')
          && exists(/databases/$(database)/documents/userCityLists/$(docId.split('__')[0]));
      }
      allow create: if (ownerPlaceOk() || userPlaceOk()) && createOk();
      allow update: if (ownerPlaceOk() || userPlaceOk()) && updateOk();
      allow delete: if isOwner();
    }
    // ===== v3.3 (أ) عدّادات الكيانات — stats_curators =====
    // معرّف المنسِّق (uid) أو uid__يوم · القراءة للمنسِّق نفسه + المالك · وظائفها تُبنى بج-١أ (صفحة المنسِّق، روابط الحملات) — محجوزة الآن
    match /stats_curators/{docId} {
      function keysOk() { return request.resource.data.keys().hasOnly(['page_view', 'contact_click', 'follow', 'ref_ig', 'ref_tt', 'ref_sc', 'ref_card', 'ref_qr', 'ref_link', 'ref_direct']) && request.resource.data.keys().size() >= 1; }
      function createOk() { return keysOk() && bumpC('page_view')
        && bumpC('contact_click')
        && bumpC('follow')
        && bumpC('ref_ig')
        && bumpC('ref_tt')
        && bumpC('ref_sc')
        && bumpC('ref_card')
        && bumpC('ref_qr')
        && bumpC('ref_link')
        && bumpC('ref_direct'); }
      function updateOk() { return keysOk() && request.resource.data.diff(resource.data).affectedKeys().size() >= 1 && bumpU('page_view')
        && bumpU('contact_click')
        && bumpU('follow')
        && bumpU('ref_ig')
        && bumpU('ref_tt')
        && bumpU('ref_sc')
        && bumpU('ref_card')
        && bumpU('ref_qr')
        && bumpU('ref_link')
        && bumpU('ref_direct'); }
      allow read: if isOwner() || (isSignedIn() && docId.split('__')[0] == request.auth.uid);
      allow create: if docId.matches('[A-Za-z0-9]{20,40}(__[0-9]{4}-[0-9]{2}-[0-9]{2})?') && createOk();
      allow update: if docId.matches('[A-Za-z0-9]{20,40}(__[0-9]{4}-[0-9]{2}-[0-9]{2})?') && updateOk();
      allow delete: if isOwner();
    }
    // ===== v3.3 (أ) عدّادات الكيانات — stats_cards =====
    // uid الصانع__معرّف البطاقة (الملكية بالمعرّف لا بحقل يُكتب) · العدّادات يزيدها أي زائر · القراءة لصانعها + المالك · تُبنى بج-١أ (بطاقة المشاركة) — محجوزة الآن
    match /stats_cards/{docId} {
      function keysOk() { return request.resource.data.keys().hasOnly(['view_ig', 'view_tt', 'view_sc', 'view_other', 'view_total']) && request.resource.data.keys().size() >= 1; }
      function createOk() { return keysOk() && bumpC('view_ig')
        && bumpC('view_tt')
        && bumpC('view_sc')
        && bumpC('view_other')
        && bumpC('view_total'); }
      function updateOk() { return keysOk() && request.resource.data.diff(resource.data).affectedKeys().size() >= 1 && bumpU('view_ig')
        && bumpU('view_tt')
        && bumpU('view_sc')
        && bumpU('view_other')
        && bumpU('view_total'); }
      allow read: if isOwner() || (isSignedIn() && docId.split('__')[0] == request.auth.uid);
      allow create: if docId.matches('[A-Za-z0-9]{20,40}__[A-Za-z0-9_-]{4,40}') && createOk();
      allow update: if docId.matches('[A-Za-z0-9]{20,40}__[A-Za-z0-9_-]{4,40}') && updateOk();
      allow delete: if isOwner();
    }

  }
}
