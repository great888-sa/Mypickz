          && (!('cityName' in request.resource.data) || (request.resource.data.cityName is string && request.resource.data.cityName.size() <= 120))
          && (!('public' in request.resource.data) || request.resource.data.public is bool)
          && (!('sharedWith' in request.resource.data) || request.resource.data.sharedWith is list);
