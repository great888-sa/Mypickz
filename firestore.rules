      allow read: if isOwner() || (isSignedIn() && exists(/databases/$(database)/documents/trips/$(docId.split('__')[0])) && get(/databases/$(database)/documents/trips/$(docId.split('__')[0])).data.ownerId == request.auth.uid);
      allow create: if docId.matches('[A-Za-z0-9_-]{1,60}(__[0-9]{4}-[0-9]{2}-[0-9]{2})?') && entId(docId) && exists(/databases/$(database)/documents/trips/$(docId.split('__')[0])) && createOk();
      allow update: if docId.matches('[A-Za-z0-9_-]{1,60}(__[0-9]{4}-[0-9]{2}-[0-9]{2})?') && entId(docId) && exists(/databases/$(database)/documents/trips/$(docId.split('__')[0])) && updateOk();
      allow delete: if isOwner();
