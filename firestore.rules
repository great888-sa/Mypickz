        && (get(/databases/$(database)/documents/userCityLists/$(bmTarget())).data.public == true
            || request.auth.uid in get(/databases/$(database)/documents/userCityLists/$(bmTarget())).data.get('sharedWith', [])) // M4.24.1 بند ١٨: المشارَك معك بالاسم
        && docId == request.auth.uid + '__' + bmTarget() // v3.17 (١١): لا سجل ثانٍ للقائمة نفسها بمعرّف ملحَق
        && (!('at' in request.resource.data) || request.resource.data.at is timestamp || request.resource.data.at is number) // v3.17 (١٠)
        && bmCounted();
      allow update: if false;
      allow delete: if isOwner() || (isSignedIn() && bmOwner() == request.auth.uid && bmReleased());
