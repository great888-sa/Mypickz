             || (request.resource.data.get('followerCount', 0) == resource.data.get('followerCount', 0) + 1
                 && !exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + uid)) && existsAfter(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + uid))) // M4.25 (٥) · v3.10: السجل يُنشأ بالطلب نفسه
             || (request.resource.data.get('followerCount', 0) == resource.data.get('followerCount', 0) - 1
                 && exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + uid)) && !existsAfter(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + uid)))));
