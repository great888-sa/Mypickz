            && (resource.data.hasAnyPublicContent == true || resource.data.get('verified', false) == true) && // M4.25 (٥)
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount','followerCount']) && // v3.17 (٣): totalFavoriteCount سُحب
            (request.resource.data.get('viewCount', 0) == resource.data.get('viewCount', 0)
